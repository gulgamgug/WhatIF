<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_fasting"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="14dp">

    <!-- Phase Pill Chip -->
    <LinearLayout
        android:id="@+id/widget_chip_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_chip_fasting"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_widget_moon"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_phase_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Waktu Puasa 🌙"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <!-- Live Countdown -->
    <Chronometer
        android:id="@+id/widget_chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_countdown_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00:00"
        android:textColor="@color/widget_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Target Info -->
    <TextView
        android:id="@+id/widget_target_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Menuju Selesai (12:00)"
        android:textColor="@color/widget_text_muted"
        android:textSize="11sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <!-- Mokel status badge -->
    <TextView
        android:id="@+id/widget_mokel_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_chip_mokel"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="Mokel: 0x"
        android:textColor="@color/widget_mokel_text"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
