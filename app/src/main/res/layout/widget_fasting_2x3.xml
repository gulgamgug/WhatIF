<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_fasting"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:text="WhatIF Tracker"
        android:textColor="@color/widget_text_muted"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- Phase Pill Chip -->
    <LinearLayout
        android:id="@+id/widget_chip_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_chip_fasting"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_moon" />

        <TextView
            android:id="@+id/widget_phase_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:singleLine="true"
            android:text="Waktu Puasa 🌙"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Big Countdown -->
    <Chronometer
        android:id="@+id/widget_chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:singleLine="true"
        android:textColor="@color/widget_text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_countdown_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:singleLine="true"
        android:text="00:00:00"
        android:textColor="@color/widget_text_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_target_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:text="Menuju Fase Makan (12:00)"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />

    <!-- Schedule info box -->
    <TextView
        android:id="@+id/widget_schedule_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:singleLine="true"
        android:text="Jadwal 16:8 (20:00 - 12:00)"
        android:textColor="@color/widget_text_muted"
        android:textSize="10sp" />

    <!-- Mokel status badge -->
    <TextView
        android:id="@+id/widget_mokel_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/widget_chip_mokel"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:singleLine="true"
        android:text="Mokel Hari Ini: 0x"
        android:textColor="@color/widget_mokel_text"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
